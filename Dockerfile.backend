# =============================================================================
# SchoolOS — Backend API Dockerfile
# =============================================================================
# IMPORTANT: This file is a TEMPLATE for the planned backend service.
# It will NOT build until you create:
#   1. backend/package.json
#   2. backend/src/ entry point (e.g. src/index.ts or src/index.js)
#
# Once the backend is implemented, run:
#   docker compose --profile backend up --build
# =============================================================================
# Stage 1: base
FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@latest --activate
WORKDIR /app

RUN apk add --no-cache wget

# =============================================================================
# Stage 2: deps
FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY backend/package.json ./backend/package.json
COPY packages/shared/package.json ./packages/shared/package.json 2>/dev/null || true
RUN pnpm fetch --frozen-lockfile && \
    pnpm install --frozen-lockfile --offline

# =============================================================================
# Stage 3: build
FROM base AS build
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN pnpm --filter @schoolos/backend build

# =============================================================================
# Stage 4: production
FROM base AS production
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 backend

ENV NODE_ENV=production \
    PORT=4000 \
    HOSTNAME="0.0.0.0"

COPY --from=deps /app/node_modules ./node_modules
COPY --from=build /app/backend/dist ./backend/dist
COPY backend/package.json ./backend/
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

RUN pnpm install --frozen-lockfile --prod && \
    chown -R backend:nodejs /app

USER backend

EXPOSE 4000

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:4000/health || exit 1

CMD ["node", "backend/dist/main.js"]

# =============================================================================
# Stage 5: development
FROM base AS development
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY backend/package.json ./backend/package.json
COPY packages/shared/package.json ./packages/shared/package.json 2>/dev/null || true
RUN pnpm fetch --frozen-lockfile && \
    pnpm install --frozen-lockfile --offline

ENV NODE_ENV=development \
    PORT=4000 \
    HOSTNAME="0.0.0.0"

EXPOSE 4000

CMD ["pnpm", "--filter", "@schoolos/backend", "dev"]

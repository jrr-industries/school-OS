{
  "name": "@schoolos/utils",
  "version": "1.0.0",
  "private": true,
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./server": {
      "types": "./src/server/index.ts",
      "default": "./src/server/index.ts"
    }
  },
  "typesVersions": {
    "*": {
      "server": ["./src/server/index.ts"]
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "dependencies": {
    "nanoid": "^5.0.9",
    "date-fns": "^4.1.0",
    "pino": "^9.6.0",
    "csv-stringify": "^6.5.2",
    "csv-parse": "^5.6.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@types/node": "^22.10.5"
  }
}

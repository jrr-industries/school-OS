{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@schoolos/ui/*": ["../../packages/ui/src/*"],
      "@schoolos/ui": ["../../packages/ui/src"],
      "@schoolos/database/*": ["../../packages/database/src/*"],
      "@schoolos/database": ["../../packages/database/src"],
      "@schoolos/auth/*": ["../../packages/auth/src/*"],
      "@schoolos/auth": ["../../packages/auth/src"],
      "@schoolos/api/*": ["../../packages/api/src/*"],
      "@schoolos/api": ["../../packages/api/src"],
      "@schoolos/config/*": ["../../packages/config/src/*"],
      "@schoolos/config": ["../../packages/config/src"],
      "@schoolos/types/*": ["../../packages/types/src/*"],
      "@schoolos/types": ["../../packages/types/src"],
      "@schoolos/utils/*": ["../../packages/utils/src/*"],
      "@schoolos/utils": ["../../packages/utils/src"],
      "@schoolos/permissions/*": ["../../packages/permissions/src/*"],
      "@schoolos/permissions": ["../../packages/permissions/src"],
      "@schoolos/hooks/*": ["../../packages/hooks/src/*"],
      "@schoolos/hooks": ["../../packages/hooks/src"],
      "@schoolos/constants/*": ["../../packages/constants/src/*"],
      "@schoolos/constants": ["../../packages/constants/src"],
      "@schoolos/validation/*": ["../../packages/validation/src/*"],
      "@schoolos/validation": ["../../packages/validation/src"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}

  bloodGroup       BloodGroup?  @map("blood_group")
  religion         String?      @db.VarChar(50)
  nationality      String?      @default("Indian") @db.VarChar(50)
  motherTongue     String?      @map("mother_tongue") @db.VarChar(50)
  caste            String?      @db.VarChar(50)
  community        String?      @db.VarChar(50)
  aadharNumber     String?      @map("aadhar_number") @db.VarChar(20)
  passportNumber   String?      @map("passport_number") @db.VarChar(20)
  ssnNumber        String?      @map("ssn_number") @db.VarChar(20)

  photo            String?      @db.Text
  signature        String?      @db.Text

  height           Decimal?     @db.Decimal(5, 2)
  weight           Decimal?     @db.Decimal(5, 2)

  status           StudentStatus @default(active)
  isArchived       Boolean      @default(false) @map("is_archived")
  archiveReason    String?      @map("archive_reason") @db.Text
  archivedAt       DateTime?    @map("archived_at")

  admissionDate    DateTime     @map("admission_date")
  leavingDate      DateTime?    @map("leaving_date")
  leavingReason    String?      @map("leaving_reason") @db.Text

  isScholarship    Boolean      @default(false) @map("is_scholarship")
  scholarshipDetails String?    @map("scholarship_details") @db.Text

  specialNeeds     String?      @map("special_needs") @db.Text
  medicalNotes     String?      @map("medical_notes") @db.Text

  profileComplete  Int          @default(0) @map("profile_complete")
  tags             String?      @db.Text

  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  deletedAt        DateTime?    @map("deleted_at")
  createdBy        String?      @map("created_by") @db.Uuid
  updatedBy        String?      @map("updated_by") @db.Uuid
  version          Int          @default(1) @map("version")

  school          School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campus          Campus?          @relation(fields: [campusId], references: [id])
  class           StudentClass?    @relation(fields: [classId], references: [id])
  section         Section?         @relation(fields: [sectionId], references: [id])
  academicYear    AcademicYear?    @relation(fields: [academicYearId], references: [id])
  category        StudentCategory? @relation(fields: [categoryId], references: [id])
  house           StudentHouse?    @relation(fields: [houseId], references: [id])
  admissionSource AdmissionSource? @relation(fields: [admissionSourceId], references: [id])

  documents        StudentDocument[]
  medical          StudentMedical?
  addresses        StudentAddress[]
  guardians        StudentGuardian[]
  emergencyContacts EmergencyContact[]
  previousSchools  StudentPreviousSchool[]
  parentStudents   ParentStudent[]
  promotions       StudentPromotion[]
  transfers        StudentTransfer[]
  archives         StudentArchive[]

  @@index([schoolId])
  @@index([campusId])
  @@index([classId])
  @@index([sectionId])
  @@index([academicYearId])
  @@index([status])
  @@index([admissionNumber])
  @@index([rollNumber])
  @@index([firstName, lastName])
  @@map("students")
}


  houseId          String?      @map("house_id") @db.Uuid
  admissionSourceId String?     @map("admission_source_id") @db.Uuid

  admissionNumber  String       @unique @map("admission_number") @db.VarChar(50)
  rollNumber       String?      @map("roll_number") @db.VarChar(20)
  emisNumber       String?      @map("emis_number") @db.VarChar(50)

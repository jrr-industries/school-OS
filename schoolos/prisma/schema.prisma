generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_DATABASE_URL")
  extensions = [citext, pgcrypto]
}

enum SchoolStatus {
  active
  inactive
  suspended
  closed
  trial
}

enum SchoolType {
  primary
  secondary
  higher_secondary
  k12
  preschool
  vocational
  special_education
}

enum UserStatus {
  active
  inactive
  suspended
  invited
  disabled
}

enum SubscriptionStatus {
  active
  inactive
  past_due
  cancelled
  expired
  trial
}

enum NotificationType {
  info
  success
  warning
  error
  alert
}

enum NotificationCategory {
  system
  attendance
  grade
  fee
  communication
  schedule
  security
}

enum AuditAction {
  create
  update
  delete
  login
  logout
  export
  import
  approve
  reject
  view
  promote
  transfer
  archive
  restore
}

enum AuditEntity {
  user
  school
  role
  permission
  subscription
  attendance
  fee
  grade
  schedule
  setting
  api_key
  file
  student
  parent
  class
  section
  subject
  campus
  department
  academic_year
  admission
  promotion
  transfer
}

enum Gender {
  male
  female
  other
}

enum BloodGroup {
  a_positive
  a_negative
  b_positive
  b_negative
  ab_positive
  ab_negative
  o_positive
  o_negative
}

enum StudentStatus {
  active
  inactive
  transferred
  graduated
  alumni
  archived
  suspended
  expelled
  withdrawn
}

enum GuardianRelationship {
  father
  mother
  guardian
  grandfather
  grandmother
  uncle
  aunt
  sibling
  other
}

enum AddressType {
  permanent
  communication
  current
}

enum TermType {
  semester
  trimester
  quarter
  term
}

enum SubjectType {
  theory
  practical
  language
  elective
  optional
  compulsory
}

enum PromotionStatus {
  promoted
  demoted
  repeated
  skipped
}

enum DocumentCategory {
  birth_certificate
  transfer_certificate
  community_certificate
  income_certificate
  medical_certificate
  passport
  aadhar
  mark_sheet
  photo
  signature
  other
}

/// Base model mixin - all tenant tables include these fields
model School {
  id              String          @id @default(uuid()) @db.Uuid
  name            String          @db.VarChar(200)
  slug            String          @unique @db.VarChar(100)
  domain          String?         @unique @db.VarChar(200)
  type            SchoolType
  curriculum      String?         @db.VarChar(50)
  address         String?         @db.Text
  city            String?         @db.VarChar(100)
  state           String?         @db.VarChar(100)
  country         String?         @db.VarChar(100)
  postalCode      String?         @db.VarChar(20)
  phone           String?         @db.VarChar(20)
  email           String?         @db.VarChar(200)
  website         String?         @db.VarChar(200)
  establishedYear Int?
  status          SchoolStatus    @default(trial)
  logo            String?         @db.Text
  settings        Json?           @default("{}")
  features        Json?           @default("{}")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  deletedAt       DateTime?       @map("deleted_at")
  version         Int             @default(1) @map("version")

  subscriptions   Subscription[]
  users           User[]
  roles           Role[]
  permissions     Permission[]
  sessions        Session[]
  auditLogs       AuditLog[]
  notifications   Notification[]
  settingsModel   Setting[]
  featureFlags    FeatureFlag[]
  apiKeys         ApiKey[]
  systemLogs      SystemLog[]
  files           File[]
  academicYears   AcademicYear[]
  academicTerms   AcademicTerm[]
  campuses        Campus[]
  buildings       Building[]
  rooms           Room[]
  departments     Department[]
  subjectGroups   SubjectGroup[]
  subjects        Subject[]
  studentCategories StudentCategory[]
  studentHouses   StudentHouse[]
  admissionSources AdmissionSource[]
  profiles        Profile[]
  userRoles       UserRole[]
  classes         StudentClass[]
  sections        Section[]
  students        Student[]
  parents         Parent[]

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  @@map("schools")
}

model SubscriptionPlan {
  id          String          @id @default(uuid()) @db.Uuid
  name        String          @db.VarChar(100)
  slug        String          @unique @db.VarChar(50)
  description String?         @db.Text
  price       Decimal         @db.Decimal(10, 2)
  currency    String          @default("USD") @db.VarChar(3)
  interval    String          @default("monthly") @db.VarChar(20)
  maxStudents Int             @default(100)
  maxTeachers Int             @default(10)
  maxStorageGB Int            @default(1)
  features    Json            @default("[]")
  isActive    Boolean         @default(true)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  deletedAt   DateTime?       @map("deleted_at")
  version     Int             @default(1) @map("version")

  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id               String             @id @default(uuid()) @db.Uuid
  schoolId         String             @map("school_id") @db.Uuid
  planId           String             @map("plan_id") @db.Uuid
  status           SubscriptionStatus @default(trial)
  startsAt         DateTime           @map("starts_at")
  endsAt           DateTime?          @map("ends_at")
  trialEndsAt      DateTime?          @map("trial_ends_at")
  cancelledAt      DateTime?          @map("cancelled_at")
  autoRenew        Boolean            @default(true)
  paymentMethod    String?            @db.VarChar(50)
  paymentReference String?            @db.VarChar(200)
  metadata         Json?              @default("{}")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  deletedAt        DateTime?          @map("deleted_at")
  createdBy        String?            @map("created_by") @db.Uuid
  updatedBy        String?            @map("updated_by") @db.Uuid
  version          Int                @default(1) @map("version")

  school School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  plan   SubscriptionPlan    @relation(fields: [planId], references: [id])

  @@unique([schoolId, planId])
  @@index([schoolId])
  @@index([status])
  @@map("subscriptions")
}

model User {
  id             String     @id @default(uuid()) @db.Uuid
  schoolId       String     @map("school_id") @db.Uuid
  email          String     @unique @db.Citext
  phone          String?    @unique @db.VarChar(20)
  name           String     @db.VarChar(200)
  avatar         String?    @db.Text
  status         UserStatus @default(active)
  isSuperAdmin   Boolean    @default(false) @map("is_super_admin")
  lastLoginAt    DateTime?  @map("last_login_at")
  emailVerifiedAt DateTime? @map("email_verified_at")
  phoneVerifiedAt DateTime? @map("phone_verified_at")
  twoFactorEnabled Boolean  @default(false) @map("two_factor_enabled")
  metadata       Json?      @default("{}")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  deletedAt      DateTime?  @map("deleted_at")
  createdBy      String?    @map("created_by") @db.Uuid
  updatedBy      String?    @map("updated_by") @db.Uuid
  version        Int        @default(1) @map("version")

  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  profile       Profile?
  userRoles     UserRole[]
  sessions      Session[]
  auditLogs     AuditLog[]
  notifications Notification[]

  @@index([schoolId])
  @@index([email])
  @@index([status])
  @@map("users")
}

model Profile {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  schoolId        String   @map("school_id") @db.Uuid
  dateOfBirth     DateTime? @map("date_of_birth")
  gender          String?  @db.VarChar(20)
  address         String?  @db.Text
  city            String?  @db.VarChar(100)
  state           String?  @db.VarChar(100)
  country         String?  @db.VarChar(100)
  postalCode      String?  @db.VarChar(20)
  timezone        String?  @default("UTC") @db.VarChar(50)
  locale          String?  @default("en") @db.VarChar(10)
  bio             String?  @db.Text
  socialLinks     Json?    @default("{}")
  emergencyContact Json?   @default("{}")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")
  createdBy       String?  @map("created_by") @db.Uuid
  updatedBy       String?  @map("updated_by") @db.Uuid
  version         Int      @default(1) @map("version")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@map("profiles")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @map("school_id") @db.Uuid
  name        String   @db.VarChar(100)
  slug        String   @db.VarChar(100)
  description String?  @db.Text
  isSystem    Boolean  @default(false) @map("is_system")
  isCustom    Boolean  @default(false) @map("is_custom")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  createdBy   String?  @map("created_by") @db.Uuid
  updatedBy   String?  @map("updated_by") @db.Uuid
  version     Int      @default(1) @map("version")

  school         School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  permissions    RolePermission[]
  userRoles      UserRole[]

  @@unique([schoolId, slug])
  @@index([schoolId])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String?  @map("school_id") @db.Uuid
  name        String   @db.VarChar(200)
  slug        String   @unique @db.VarChar(200)
  description String?  @db.Text
  group       String   @db.VarChar(50)
  isSystem    Boolean  @default(true) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  createdBy   String?  @map("created_by") @db.Uuid
  updatedBy   String?  @map("updated_by") @db.Uuid
  version     Int      @default(1) @map("version")

  school       School?          @relation(fields: [schoolId], references: [id])
  rolePermissions RolePermission[]

  @@index([slug])
  @@index([group])
  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid()) @db.Uuid
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@index([schoolId])
  @@map("user_roles")
}

model Session {
  id            String    @id @default(uuid()) @db.Uuid
  schoolId      String    @map("school_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  token         String    @unique @db.Text
  refreshToken  String?   @unique @map("refresh_token") @db.Text
  ipAddress     String?   @map("ip_address") @db.VarChar(45)
  userAgent     String?   @map("user_agent") @db.Text
  location      String?   @db.VarChar(200)
  deviceType    String?   @map("device_type") @db.VarChar(50)
  expiresAt     DateTime  @map("expires_at")
  refreshExpiresAt DateTime? @map("refresh_expires_at")
  lastActiveAt  DateTime? @map("last_active_at")
  isRevoked     Boolean   @default(false) @map("is_revoked")
  revokedAt     DateTime? @map("revoked_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")
  version       Int       @default(1) @map("version")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("sessions")
}

model AuditLog {
  id          String      @id @default(uuid()) @db.Uuid
  schoolId    String      @map("school_id") @db.Uuid
  userId      String?     @map("user_id") @db.Uuid
  action      AuditAction
  entity      AuditEntity
  entityId    String?     @map("entity_id") @db.Uuid
  description String?     @db.Text
  changes     Json?       @default("{}")
  ipAddress   String?     @map("ip_address") @db.VarChar(45)
  userAgent   String?     @map("user_agent") @db.Text
  metadata    Json?       @default("{}")
  createdAt   DateTime    @default(now()) @map("created_at")

  school School? @relation(fields: [schoolId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])

  @@index([schoolId])
  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id          String             @id @default(uuid()) @db.Uuid
  schoolId    String             @map("school_id") @db.Uuid
  userId      String?            @map("user_id") @db.Uuid
  type        NotificationType   @default(info)
  category    NotificationCategory @default(system)
  title       String             @db.VarChar(200)
  message     String?            @db.Text
  link        String?            @db.Text
  isRead      Boolean            @default(false) @map("is_read")
  readAt      DateTime?          @map("read_at")
  metadata    Json?              @default("{}")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  deletedAt   DateTime?          @map("deleted_at")
  version     Int                @default(1) @map("version")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id])

  @@index([schoolId])
  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

model Setting {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  key       String   @db.VarChar(200)
  value     Json
  group     String   @default("general") @db.VarChar(50)
  isPublic  Boolean  @default(false) @map("is_public")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  version   Int      @default(1) @map("version")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, key])
  @@index([schoolId])
  @@index([key])
  @@map("settings")
}

model FeatureFlag {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @map("school_id") @db.Uuid
  key         String   @db.VarChar(200)
  enabled     Boolean  @default(false)
  description String?  @db.Text
  metadata    Json?    @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  createdBy   String?  @map("created_by") @db.Uuid
  updatedBy   String?  @map("updated_by") @db.Uuid
  version     Int      @default(1) @map("version")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, key])
  @@index([schoolId])
  @@map("feature_flags")
}

model ApiKey {
  id          String    @id @default(uuid()) @db.Uuid
  schoolId    String    @map("school_id") @db.Uuid
  name        String    @db.VarChar(200)
  key         String    @unique @db.Text
  prefix      String    @db.VarChar(10)
  permissions Json      @default("[]")
  ipWhitelist String?   @map("ip_whitelist") @db.Text
  rateLimit   Int?      @default(100) @map("rate_limit")
  lastUsedAt  DateTime? @map("last_used_at")
  expiresAt   DateTime? @map("expires_at")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  createdBy   String?   @map("created_by") @db.Uuid
  updatedBy   String?   @map("updated_by") @db.Uuid
  version     Int       @default(1) @map("version")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([key])
  @@map("api_keys")
}

model SystemLog {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  level     String   @default("info") @db.VarChar(20)
  message   String   @db.Text
  source    String?  @db.VarChar(200)
  stack     String?  @db.Text
  metadata  Json?    @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([level])
  @@index([createdAt])
  @@map("system_logs")
}

model File {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @map("school_id") @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  name        String   @db.VarChar(500)
  originalName String  @map("original_name") @db.VarChar(500)
  mimeType    String   @map("mime_type") @db.VarChar(100)
  size        Int
  path        String   @db.Text
  bucket      String   @db.VarChar(100)
  category    String   @db.VarChar(50)
  altText     String?  @map("alt_text") @db.Text
  metadata    Json?    @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  createdBy   String?  @map("created_by") @db.Uuid
  updatedBy   String?  @map("updated_by") @db.Uuid
  version     Int      @default(1) @map("version")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([userId])
  @@index([category])
  @@index([bucket])
  @@map("files")
}

// ============================================================
// ACADEMIC STRUCTURE
// ============================================================

model AcademicYear {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @map("school_id") @db.Uuid
  name        String   @db.VarChar(100)
  startDate   DateTime @map("start_date")
  endDate     DateTime @map("end_date")
  isCurrent   Boolean  @default(false) @map("is_current")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  createdBy   String?  @map("created_by") @db.Uuid
  updatedBy   String?  @map("updated_by") @db.Uuid
  version     Int      @default(1) @map("version")

  school School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  terms  AcademicTerm[]
  classes StudentClass[]
  students Student[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([isCurrent])
  @@map("academic_years")
}

model AcademicTerm {
  id            String   @id @default(uuid()) @db.Uuid
  schoolId      String   @map("school_id") @db.Uuid
  academicYearId String  @map("academic_year_id") @db.Uuid
  name          String   @db.VarChar(100)
  type          TermType @default(term)
  startDate     DateTime @map("start_date")
  endDate       DateTime @map("end_date")
  isCurrent     Boolean  @default(false) @map("is_current")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")
  createdBy     String?  @map("created_by") @db.Uuid
  updatedBy     String?  @map("updated_by") @db.Uuid
  version       Int      @default(1) @map("version")

  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  @@unique([academicYearId, name])
  @@index([schoolId])
  @@index([academicYearId])
  @@map("academic_terms")
}

model Campus {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  name      String   @db.VarChar(200)
  code      String?  @db.VarChar(20)
  address   String?  @db.Text
  city      String?  @db.VarChar(100)
  state     String?  @db.VarChar(100)
  country   String?  @db.VarChar(100)
  phone     String?  @db.VarChar(20)
  email     String?  @db.VarChar(200)
  isMain    Boolean  @default(false) @map("is_main")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  version   Int      @default(1) @map("version")

  school   School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  buildings Building[]
  classes   StudentClass[]
  students  Student[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("campuses")
}

model Building {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  campusId  String   @map("campus_id") @db.Uuid
  name      String   @db.VarChar(200)
  code      String?  @db.VarChar(20)
  floors    Int      @default(1)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  version   Int      @default(1) @map("version")

